# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
# Restrict the bot to a single Telegram user id (recommended for a personal
# finance bot). Leave empty to allow anyone who has the token to use it.
TELEGRAM_ALLOWED_USER_ID=

# ---------------------------------------------------------------------------
# LLM provider (any OpenAI-compatible endpoint works)
# ---------------------------------------------------------------------------
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://localhost:8000/v1
#   LM Studio:   http://localhost:1234/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Only for reasoning models (o-series, gpt-5.x...). Leave empty to omit.
LLM_REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_PATH=data/expenses.db

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=UZS

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# Path to the tesseract binary. Leave default if it's on PATH.
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ---------------------------------------------------------------------------
# Exports
# ---------------------------------------------------------------------------
EXPORT_DIR=exports
