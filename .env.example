# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
# Restrict the bot to a single Telegram user id (recommended for a personal
# finance bot). Leave empty to allow anyone who has the token to use it.
TELEGRAM_ALLOWED_USER_ID=

# ---------------------------------------------------------------------------
# LLM provider (any OpenAI-compatible endpoint works)
# ---------------------------------------------------------------------------
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://localhost:8000/v1
#   LM Studio:   http://localhost:1234/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Only for reasoning models (o-series, gpt-5.x...). Leave empty to omit.
LLM_REASONING_EFFORT=
# Optional second provider, tried only once the primary above exhausts its
# own retries. Leave LLM_BASE_URL_FALLBACK empty (default) for no fallback
# -- pure no-op. LLM_MODEL_FALLBACK defaults to LLM_MODEL if left empty.
LLM_BASE_URL_FALLBACK=
LLM_API_KEY_FALLBACK=
LLM_MODEL_FALLBACK=
# How often (seconds) to retry messages queued while the LLM was unreachable.
RETRY_QUEUE_INTERVAL_SECONDS=60
# Try a local, offline, keyword-based parser for plain expense messages
# ("45k taxi") before calling the LLM -- see expense_ai/local_parser.py.
# Off by default; flip on once you've reviewed how it behaves on your data.
LOCAL_PARSER_ENABLED=false

# Comma-separated last-4 digits of every card that shows a balance in your
# banking app's card list, e.g. "1111,2222,3333,4444". Enables the local
# (no-LLM) OCR for /sync screenshots -- see expense_ai/card_ocr.py. A read is
# only trusted when EVERY listed card is found and the amount count matches,
# so a dropped line defers to the vision LLM instead of quietly undercounting
# your balance. Leave empty to always use the LLM for /sync.
SYNC_CARD_LAST4=

# ---------------------------------------------------------------------------
# Scheduled jobs (proactive daily/monthly recaps, reconciliation, DB backup)
# ---------------------------------------------------------------------------
# Hour of day (0-23, in TZ below) for the evening recap and month-end summary.
DAILY_SUMMARY_HOUR=21
# Hour of day (0-23) for the monthly balance/savings reconciliation prompt.
RECONCILIATION_HOUR=9
# How often (hours) to send the DB as a Telegram document backup to the owner.
BACKUP_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_PATH=data/expenses.db

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=UZS

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
# IANA name, e.g. "Asia/Tashkent", "America/New_York". Every "today"/"this
# week" boundary, history-log date, and stored timestamp uses this. Set this
# explicitly for Docker -- a container's clock is UTC by default regardless
# of the host machine's timezone, which otherwise makes every date/time the
# bot shows you off by your UTC offset.
TZ=UTC

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ---------------------------------------------------------------------------
# Exports
# ---------------------------------------------------------------------------
EXPORT_DIR=exports
